# Normalize line endings to LF in the repo
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Source / config
*.py    text diff=python
*.toml  text
*.md    text diff=markdown
*.json  text
*.yml   text
*.yaml  text

# Lockfiles: don't diff in reviews
uv.lock linguist-generated=true -diff

# Binary files
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.mp4   binary
*.mov   binary
*.mp3   binary
*.wav   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.whl   binary
*.pkl   binary
*.npy   binary
*.npz   binary
*.pt    binary
*.onnx  binary
