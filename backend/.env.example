# Storage
DATA_DIR=/data
MODELS_DIR=/models
HOST_MODELS_DIR=./models

# PostgreSQL
POSTGRES_USER=scene
POSTGRES_PASSWORD=scene
POSTGRES_DB=scene
DATABASE_URL=postgresql://scene:scene@postgres:5432/scene

# API
CORS_ORIGINS=http://localhost:3000
# GET /search reranks this many Objects nearest the query embedding, plus every label match
SEARCH_CANDIDATES=20
# GET /search keeps reranked Objects within this relevance of the best match (plus every label match), 10 at most
SEARCH_MARGIN=0.05

# Pipeline: pipeline.fake.yaml (skeleton), pipeline.fake-gpu.yaml (remote fakes), pipeline.yaml (real)
PIPELINE_CONFIG=/app/backend/config/pipeline.fake.yaml
COMPUTE_CONFIG=/app/backend/config/compute.yaml
# Folder read at start; found from the source layout when unset. Set it for an installed package.
# CONFIG_DIR=/app/backend/config
# Compute Target names from compute.yaml; no provider is the default. The worker refuses to start
# when a Target used by the selected pipeline is unset or has no URL.
GPU_TARGET=                          # every GPU Stage of pipeline.yaml and pipeline.fake-gpu.yaml, e.g. colab

# Compute targets (only the ones you use)
COMPUTE_TOKEN=
COLAB_URL=                           # public tunnel URL from Colab (Cloudflare/Ngrok); changes with each session
COMPUTE_IMAGE_REPO=<dockerhub-user>/scene-compute   # tags become <variant>-<git short sha>
LOCAL_GPU_EXTRAS=

# Hugging Face (gated weights)
HF_TOKEN=
