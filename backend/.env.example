# Every backend environment variable. The Colab notebook (backend/deploy/colab/GPU.ipynb) sets these
# for scene-compute, scene-api and scene-worker; nothing reads this file.

# Storage
DATA_DIR=/content/data                # Publications; scene-compute keeps Target Workspaces in DATA_DIR/target
MODELS_DIR=/content/drive/MyDrive/model-weights/models

# PostgreSQL, installed on the Colab runtime and listening only on localhost
DATABASE_URL=postgresql://scene:scene@127.0.0.1:5432/scene

# API
CORS_ORIGINS=http://localhost:3000    # the local Vite dev server
# GET /search reranks this many Objects nearest the query embedding, plus every label match
SEARCH_CANDIDATES=20
# GET /search keeps reranked Objects within this relevance of the best match (plus every label match), 10 at most
SEARCH_MARGIN=0.05

# Pipeline: pipeline.yaml (real); pipeline.fake.yaml (fakes on the cpu Target) is the default when unset
PIPELINE_CONFIG=/content/3D-scene/backend/config/pipeline.yaml
COMPUTE_CONFIG=/content/3D-scene/backend/config/compute.yaml
# Folder read at start; found from the source layout when unset. Set it for an installed package.
# CONFIG_DIR=/content/3D-scene/backend/config
# Compute Target name from compute.yaml for pipeline.yaml. The worker refuses to start when it is unset.
GPU_TARGET=colab

# Hugging Face (gated weights); the notebook reads it from Colab secrets
HF_TOKEN=
